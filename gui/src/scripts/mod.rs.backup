        push(ScriptMeta {
            id: "windsurf",
            name: "Windsurf",
            category: Category::Editors,
            script_type: ScriptType::InstallUninstall,
            filename: "ai-editors/windsurf.sh",
            requires_sudo: false,  // Handles own auth via dt_sudo
            timeout_minutes: None,
        });
        push(ScriptMeta {
            id: "antigravity",
            name: "Antigravity",
            category: Category::Editors,
            script_type: ScriptType::InstallUninstall,
            filename: "ai-editors/antigravity.sh",
            requires_sudo: false,  // Handles own auth via dt_sudo
            timeout_minutes: None,
        });

        // Package scripts
        push(ScriptMeta {
            id: "default_packages",
            name: "Default Packages",
            category: Category::Packages,
            script_type: ScriptType::PackageManager,
            filename: "packages/default_packages.sh",
            requires_sudo: true,
            timeout_minutes: None,
