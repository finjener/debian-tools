        // AI Editor scripts
        push(ScriptMeta {
            id: "cursor",
            name: "Cursor",
            category: Category::Editors,
            script_type: ScriptType::InstallUninstall,
            filename: "ai-editors/cursor.sh",
            requires_sudo: false,  // Handles own auth via dt_sudo
