        // System scripts
        push(ScriptMeta {
            id: "grub_config",
            name: "GRUB Config",
            category: Category::System,
            script_type: ScriptType::Configure,
            filename: "system/grub_config.sh",
            requires_sudo: true,
            timeout_minutes: None,
        });
        push(ScriptMeta {
            id: "unstable_repo",
            name: "Unstable Repo",
            category: Category::System,
            script_type: ScriptType::Configure,
            filename: "system/unstable_repo.sh",
            requires_sudo: true,
            timeout_minutes: None,
        });
        push(ScriptMeta {
            id: "sources_list_contrib_nonfree",
            name: "Sources List (Contrib/Non-Free)",
            category: Category::System,
            script_type: ScriptType::Configure,
            filename: "system/sources_list_contrib_nonfree.sh",
            requires_sudo: true,
            timeout_minutes: None,
        });
        push(ScriptMeta {
            id: "bashrc_configs",
            name: "Bashrc Configs",
            category: Category::System,
            script_type: ScriptType::BackupRestore,
            filename: "system/bashrc_configs.sh",
            requires_sudo: false,
            timeout_minutes: None,
        });
        push(ScriptMeta {
            id: "add_to_sudoers",
            name: "Add to Sudoers",
            category: Category::System,
            script_type: ScriptType::Configure,
            filename: "system/add_to_sudoers.sh",
            requires_sudo: true,
            timeout_minutes: None,
        });
        push(ScriptMeta {
            id: "user_groups",
            name: "User Groups",
            category: Category::System,
            script_type: ScriptType::Configure,
            filename: "system/user_groups.sh",
            requires_sudo: true,
            timeout_minutes: None,
        });
        push(ScriptMeta {
            id: "change_os_id",
            name: "Change OS ID",
            category: Category::System,
            script_type: ScriptType::Configure,
            filename: "system/change_os_id.sh",
            requires_sudo: true,
            timeout_minutes: None,
        });
        push(ScriptMeta {
            id: "systemd_resolved_config",
            name: "Systemd Resolved Config",
            category: Category::System,
            script_type: ScriptType::Configure,
            filename: "system/systemd_resolved_config.sh",
            requires_sudo: true,
            timeout_minutes: None,
        });
        push(ScriptMeta {
            id: "xanmod",
            name: "XanMod Kernel",
            category: Category::System,
            script_type: ScriptType::InstallUninstall,
            filename: "system/xanmod.sh",
            requires_sudo: false,
            timeout_minutes: None,
        });

        // Android scripts
        push(ScriptMeta {
            id: "android_flash",
            name: "Android Flash",
            category: Category::Android,
            script_type: ScriptType::Interactive,
            filename: "android/android_flash.sh",
            requires_sudo: false,
            timeout_minutes: None,
        });
        push(ScriptMeta {
            id: "android_pixel_root",
            name: "Android Pixel Root",
            category: Category::Android,
            script_type: ScriptType::Interactive,
            filename: "android/android_pixel_root.sh",
            requires_sudo: false,
