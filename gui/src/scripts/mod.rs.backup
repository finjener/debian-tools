        // Gaming
        push(ScriptMeta {
            id: "steam",
            name: "Steam",
            category: Category::Gaming,
            script_type: ScriptType::InstallUninstall,
            filename: "gaming/steam.sh",
            requires_sudo: false,  // Handles own auth via dt_sudo
            timeout_minutes: None,
        });

        // Communication
        push(ScriptMeta {
            id: "signal",
            name: "Signal",
            category: Category::Communication,
            script_type: ScriptType::InstallUninstall,
            filename: "communication/signal.sh",
            requires_sudo: false,  // Handles own auth via dt_sudo
            timeout_minutes: None,
        });
        push(ScriptMeta {
            id: "ente_auth",
            name: "Ente Auth",
            category: Category::Communication,
            script_type: ScriptType::InstallUninstall,
            filename: "communication/ente_auth.sh",
            requires_sudo: false,
            timeout_minutes: None,
        });
        push(ScriptMeta {
            id: "ente_photos",
            name: "Ente Photos",
            category: Category::Communication,
            script_type: ScriptType::InstallUninstall,
            filename: "communication/ente_photos.sh",
            requires_sudo: false,
            timeout_minutes: None,
        });

        // Development scripts
        push(ScriptMeta {
            id: "vscodium",
            name: "VSCodium",
            category: Category::Development,
            script_type: ScriptType::InstallUninstall,
            filename: "development/vscodium.sh",
            requires_sudo: false,  // Handles own auth via dt_sudo
            timeout_minutes: None,
        });
        push(ScriptMeta {
            id: "unityhub",
            name: "Unity Hub",
            category: Category::Development,
            script_type: ScriptType::InstallUninstall,
            filename: "development/unityhub.sh",
            requires_sudo: false,  // Handles own auth via dt_sudo
            timeout_minutes: None,
