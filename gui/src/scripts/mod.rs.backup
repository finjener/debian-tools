//! Script registry - all debian-tools scripts

mod types;
pub mod runner;
pub mod status;

pub use types::*;

use std::collections::HashMap;

/// Registry of all available scripts
pub struct ScriptRegistry {
    order: Vec<ScriptMeta>,
    index: HashMap<&'static str, usize>,
}

impl ScriptRegistry {
    pub fn new() -> Self {
        let mut order: Vec<ScriptMeta> = Vec::new();
        let mut index: HashMap<&'static str, usize> = HashMap::new();

        let mut push = |s: ScriptMeta| {
            let id = s.id;
            if index.contains_key(id) {
                // In case of programmer error, keep first entry stable.
                return;
            }
            index.insert(id, order.len());
            order.push(s);
        };

        // Security scripts
        push(ScriptMeta {
            id: "ssh_keys",
            name: "SSH Keys",
            category: Category::Security,
            script_type: ScriptType::BackupRestore,
            filename: "security/ssh_keys.sh",
            requires_sudo: false,
            timeout_minutes: None,
        });
        push(ScriptMeta {
            id: "gpg_keys",
            name: "GPG Keys",
            category: Category::Security,
            script_type: ScriptType::BackupRestore,
            filename: "security/gpg_keys.sh",
            requires_sudo: false,
            timeout_minutes: None,
        });
        push(ScriptMeta {
            id: "kwallet",
            name: "KWallet",
            category: Category::Security,
            script_type: ScriptType::BackupRestore,
            filename: "security/kwallet_backup.sh",
            requires_sudo: false,
            timeout_minutes: None,
        });
        push(ScriptMeta {
            id: "git_config",
            name: "Git Config",
            category: Category::Security,
            script_type: ScriptType::BackupRestore,
            filename: "security/git_config.sh",
            requires_sudo: false,
            timeout_minutes: None,
        });

        // Desktop scripts
        push(ScriptMeta {
            id: "kde_settings",
            name: "KDE Settings",
            category: Category::Desktop,
            script_type: ScriptType::BackupRestore,
            filename: "desktop/kde_settings.sh",
            requires_sudo: false,
            timeout_minutes: None,
        });

        // VPN scripts
        push(ScriptMeta {
            id: "mullvad",
            name: "Mullvad VPN",
            category: Category::Vpn,
            script_type: ScriptType::InstallUninstall,
            filename: "vpn/mullvad.sh",
            requires_sudo: false,  // Handles own auth via dt_sudo
            timeout_minutes: None,
        });
        push(ScriptMeta {
            id: "ivpn",
            name: "IVPN",
            category: Category::Vpn,
            script_type: ScriptType::InstallUninstall,
            filename: "vpn/ivpn.sh",
            requires_sudo: false,  // Handles own auth via dt_sudo
            timeout_minutes: None,
        });

        push(ScriptMeta {
            id: "nym_vpn",
            name: "Nym VPN",
            category: Category::Vpn,
            script_type: ScriptType::InstallUninstall,
            filename: "vpn/nym_vpn.sh",
            requires_sudo: false,  // Handles own auth via dt_sudo
            timeout_minutes: None,
        });

        // Browser scripts
        push(ScriptMeta {
            id: "brave",
            name: "Brave Browser",
            category: Category::Browsers,
            script_type: ScriptType::InstallUninstall,
            filename: "browsers/brave-browser.sh",
            requires_sudo: false,  // Handles own auth via dt_sudo
            timeout_minutes: None,
        });
        push(ScriptMeta {
            id: "librewolf",
            name: "LibreWolf",
            category: Category::Browsers,
            script_type: ScriptType::InstallUninstall,
            filename: "browsers/librewolf.sh",
            requires_sudo: false,  // Handles own auth via dt_sudo
            timeout_minutes: None,
        });
        push(ScriptMeta {
            id: "floorp",
            name: "Floorp",
            category: Category::Browsers,
            script_type: ScriptType::InstallUninstall,
            filename: "browsers/floorp.sh",
            requires_sudo: false,  // Handles own auth via dt_sudo
            timeout_minutes: None,
