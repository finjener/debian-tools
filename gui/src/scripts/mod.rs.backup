            timeout_minutes: None,
        });

        // Desktop scripts (additional)
        push(ScriptMeta {
            id: "sddm_kwallet_pam",
            name: "SDDM KWallet PAM",
            category: Category::Desktop,
            script_type: ScriptType::Configure,
            filename: "desktop/sddm_kwallet_pam.sh",
            requires_sudo: true,
            timeout_minutes: None,
        });

        // Virtualization
        push(ScriptMeta {
            id: "qemu_kvm",
            name: "QEMU/KVM",
            category: Category::Virtualization,
            script_type: ScriptType::InstallUninstall,
            filename: "virtualization/qemu_kvm.sh",
            requires_sudo: true,
            timeout_minutes: None,
        });
        push(ScriptMeta {
            id: "waydroid",
            name: "Waydroid",
            category: Category::Virtualization,
            script_type: ScriptType::InstallUninstall,
            filename: "virtualization/waydroid.sh",
            requires_sudo: true,
            timeout_minutes: None,
        });

        Self { order, index }
    }

    pub fn get(&self, id: &str) -> Option<&ScriptMeta> {
        self.index
            .get(id)
            .and_then(|i| self.order.get(*i))
    }

    pub fn by_category(&self, category: Category) -> Vec<&ScriptMeta> {
        self.order
            .iter()
            .filter(|s| s.category == category)
            .collect()
    }

    pub fn all(&self) -> impl Iterator<Item = &ScriptMeta> {
        self.order.iter()
    }
}

impl Default for ScriptRegistry {
    fn default() -> Self {
        Self::new()
    }
}
